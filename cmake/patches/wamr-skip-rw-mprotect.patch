@@ -6274,6 +6391,9 @@ wasm_munmap_linear_memory(void *mapped_mem, uint64 commit_size, uint64 map_size)
     os_mem_decommit(mapped_mem, commit_size);
 #else
     (void)commit_size;
+#endif
+#if defined(OS_ENABLE_HW_BOUND_CHECK) && defined(BH_PLATFORM_LINUX)
+    linear_memory_rw_remove(mapped_mem);
 #endif
     os_munmap(mapped_mem, map_size);
 }
@@ -6320,6 +6440,10 @@ wasm_mmap_linear_memory(uint64_t map_size, uint64 *io_memory_data_size,
     /* Newly allocated pages are filled with zero by the OS, we don't fill it
      * again here */
 
+#if defined(OS_ENABLE_HW_BOUND_CHECK) && defined(BH_PLATFORM_LINUX)
+    linear_memory_rw_enter(mapped_mem, memory_data_size);
+#endif
+
     *io_memory_data_size = memory_data_size;
 
     return mapped_mem;
